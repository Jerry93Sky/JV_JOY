{
  "name": "bms-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:backend": "pnpm --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "build:backend": "pnpm --filter backend build",
    "build:frontend": "pnpm --filter frontend build",
    "db:migrate": "pnpm --filter backend db:migrate",
    "db:seed": "pnpm --filter backend db:seed",
    "db:studio": "pnpm --filter backend db:studio",
    "typecheck:shared": "pnpm --filter frontend exec tsc -p ../../packages/shared/tsconfig.jv.json",
    "test:jv": "pnpm --filter @bms/shared test:jv",
    "build:shared": "pnpm --filter frontend exec tsc -p ../../packages/shared/tsconfig.jv.json",
    "validate:jv-fixtures": "node tools/jv/validate-json-fixtures.mjs",
    "parity:jv-order": "node --experimental-strip-types tools/jv/compare-line-order-excel-golden.mjs",
    "smoke:jv-line-lab": "pnpm --filter frontend exec node scripts/smoke-line-lab-ssr.mjs"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
